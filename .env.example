# Supabase Configuration (REQUIRED)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Resend Configuration (For email notifications)
# Note: Configure RESEND_API_KEY in Supabase Edge Functions secrets
# Get your API key at: https://resend.com/api-keys

# Twilio Configuration (Optional for SMS notifications)
# Note: These are configured in Supabase Edge Functions secrets
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1234567890
